@using SharedModelsLib;

@if (Teams != null)
{
    <p class="badge bg-success">Il y a @Teams.Count équipes</p>
}
<div class="container mt-5">
    <h2 class="text-center mb-4">Liste des équipes</h2>

    <div class="table-responsive">
        <table class="table table-striped table-hover table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Nom du l'équipe</th>
                    <th>Joueurs</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var team in Teams)
                {
                    <tr>
                        <td>@team.Name</td>
                        <td>
                            @if (team.Players.Count == 0)
                            {
                                <span class="badge bg-warning">0 joueur(se)</span>
                            }
                            else
                            {
                                <ul>
                                @foreach (var player in team.Players)
                                {
                                    <li class="badge bg-secondary">@player</li>
                                }
                                </ul>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div> 


@code {

    [Parameter]
    public List<Team> Teams { get; set; }

    
}
